# Copy this file to .env and fill in real values. Never commit .env.

# Server (DirectAdmin/Passenger ignores PORT and assigns its own)
PORT=4000
NODE_ENV=production

# Public URL(s) of the frontend. Used for CORS and password-reset links.
# Separate several origins with commas.
FRONTEND_URL=https://forum.example.com

# MySQL (on DirectAdmin the names are prefixed with your username, e.g. user_forum)
DB_HOST=localhost
DB_PORT=3306
DB_USER=username_forum
DB_PASSWORD=change-me
DB_NAME=username_forum

# Authentication: use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me

# Email (Gmail App Password) for password-reset emails
EMAIL_USER=
EMAIL_PASS=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional: leave blank unless you have confirmed another current text model.
GEMINI_FALLBACK_MODEL=

# Semantic search
SEMANTIC_SEARCH_DEFAULT_K=10
SEMANTIC_SEARCH_RECOMMEND_THRESHOLD=0.6
SEMANTIC_SEARCH_MAX_K=20
SEMANTIC_SEARCH_BACKFILL_LIMIT=10
